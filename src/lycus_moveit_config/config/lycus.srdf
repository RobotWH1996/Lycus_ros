    <disable_collisions link1="AR5-5_08R-W4C1C5-ZY2_link7" link2="AR5-5_08R-W4C1C5-ZY2_flan_link" reason="Adjacent"/>
    <disable_collisions link1="AR5-5_08R-W4C1C5-ZY2_flan_link" link2="right_gripper_base" reason="Adjacent"/>
    <disable_collisions link1="right_gripper_base" link2="right_gripper_right_jaw" reason="Adjacent"/>
    <disable_collisions link1="right_gripper_base" link2="right_gripper_left_jaw" reason="Adjacent"/>
    <disable_collisions link1="right_gripper_base" link2="right_arm_ee_link" reason="Adjacent"/>
    <disable_collisions link1="right_gripper_left_jaw" link2="right_gripper_right_jaw" reason="Never"/>

    <!-- CAD visual STLs overlap skip-one neighbors even in valid poses. -->
    <disable_collisions link1="Chassis_link" link2="Thigh_link" reason="Never"/>
    <disable_collisions link1="Calf_link" link2="Waist_link" reason="Never"/>
    <disable_collisions link1="Thigh_link" link2="Chest_link" reason="Never"/>
    <disable_collisions link1="Waist_link" link2="Neck_link" reason="Never"/>
    <disable_collisions link1="Chest_link" link2="Head_link" reason="Never"/>
