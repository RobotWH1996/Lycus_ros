    <disable_collisions link1="AR5-5_08L-W4C1C5-ZY2_link7" link2="AR5-5_08L-W4C1C5-ZY2_flan_link" reason="Adjacent"/>
    <disable_collisions link1="AR5-5_08L-W4C1C5-ZY2_flan_link" link2="left_gripper_base" reason="Adjacent"/>
    <disable_collisions link1="left_gripper_base" link2="left_gripper_right_jaw" reason="Adjacent"/>
    <disable_collisions link1="left_gripper_base" link2="left_gripper_left_jaw" reason="Adjacent"/>
    <disable_collisions link1="left_gripper_base" link2="left_arm_ee_link" reason="Adjacent"/>
    <disable_collisions link1="left_gripper_left_jaw" link2="left_gripper_right_jaw" reason="Never"/>
    <disable_collisions link1="AR5-5_08R-W4C1C5-ZY2_base" link2="AR5-5_08R-W4C1C5-ZY2_link1" reason="Adjacent"/>
    <disable_collisions link1="AR5-5_08R-W4C1C5-ZY2_link1" link2="AR5-5_08R-W4C1C5-ZY2_link2" reason="Adjacent"/>
    <disable_collisions link1="AR5-5_08R-W4C1C5-ZY2_link2" link2="AR5-5_08R-W4C1C5-ZY2_link3" reason="Adjacent"/>
