<?xml version="1.0" encoding="UTF-8"?>
<robot name="lycus">
    <group name="left_arm">
        <chain base_link="AR5-5_08L-W4C1C5-ZY2_base" tip_link="left_arm_ee_link"/>
    </group>
    <group name="right_arm">
        <chain base_link="AR5-5_08R-W4C1C5-ZY2_base" tip_link="right_arm_ee_link"/>
    </group>
    <group name="both_arms">
        <group name="left_arm"/>
        <group name="right_arm"/>
    </group>
    <group name="torso">
        <joint name="Calf_joint"/>
        <joint name="Thigh_joint"/>
        <joint name="Waist_joint"/>
        <joint name="Chest_joint"/>
        <chain base_link="Chassis_link" tip_link="Chest_link"/>
    </group>
    <group name="head">
        <joint name="Neck_joint"/>
        <joint name="Head_joint"/>
        <chain base_link="Chest_link" tip_link="Head_link"/>
    </group>

    <group_state name="left_arm_start" group="left_arm">
        <joint name="AR5-5_08L-W4C1C5-ZY2_joint_1" value="0"/>
        <joint name="AR5-5_08L-W4C1C5-ZY2_joint_2" value="0"/>
        <joint name="AR5-5_08L-W4C1C5-ZY2_joint_3" value="0"/>
        <joint name="AR5-5_08L-W4C1C5-ZY2_joint_4" value="0"/>
        <joint name="AR5-5_08L-W4C1C5-ZY2_joint_5" value="0"/>
        <joint name="AR5-5_08L-W4C1C5-ZY2_joint_6" value="0"/>
        <joint name="AR5-5_08L-W4C1C5-ZY2_joint_7" value="0"/>
    </group_state>
    <group_state name="right_arm_start" group="right_arm">
        <joint name="AR5-5_08R-W4C1C5-ZY2_joint_1" value="0"/>
        <joint name="AR5-5_08R-W4C1C5-ZY2_joint_2" value="0"/>
        <joint name="AR5-5_08R-W4C1C5-ZY2_joint_3" value="0"/>
        <joint name="AR5-5_08R-W4C1C5-ZY2_joint_4" value="0"/>
        <joint name="AR5-5_08R-W4C1C5-ZY2_joint_5" value="0"/>
        <joint name="AR5-5_08R-W4C1C5-ZY2_joint_6" value="0"/>
        <joint name="AR5-5_08R-W4C1C5-ZY2_joint_7" value="0"/>
    </group_state>

    <passive_joint name="left_gripper_mimic"/>
    <passive_joint name="right_gripper_mimic"/>

    <disable_collisions link1="world" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="Chassis_link" reason="Adjacent"/>
    <disable_collisions link1="Chassis_link" link2="Wheel1_link" reason="Adjacent"/>
    <disable_collisions link1="Chassis_link" link2="Wheel2_link" reason="Adjacent"/>
    <disable_collisions link1="Chassis_link" link2="Wheel3_link" reason="Adjacent"/>
    <disable_collisions link1="Chassis_link" link2="Wheel4_link" reason="Adjacent"/>
    <disable_collisions link1="Chassis_link" link2="Calf_link" reason="Adjacent"/>
    <disable_collisions link1="Calf_link" link2="Thigh_link" reason="Adjacent"/>
    <disable_collisions link1="Thigh_link" link2="Waist_link" reason="Adjacent"/>
    <disable_collisions link1="Waist_link" link2="Chest_link" reason="Adjacent"/>
    <disable_collisions link1="Chest_link" link2="Neck_link" reason="Adjacent"/>
    <disable_collisions link1="Neck_link" link2="Head_link" reason="Adjacent"/>
