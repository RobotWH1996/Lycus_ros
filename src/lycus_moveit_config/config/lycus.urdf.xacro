<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lycus">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:include filename="$(find lycus_description)/urdf/lycus.urdf" />
    <xacro:include filename="lycus.ros2_control.xacro" />
    <xacro:lycus_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>
</robot>
